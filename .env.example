# PORT: HTTP port for the Express + Vite server (default: 3000)
PORT=3000

# JWT_SECRET: Secret (min 16 chars) used to sign admin session cookies.
# If omitted, a random secret is generated on startup (sessions reset on restart).
JWT_SECRET=""

# ADMIN_PASSCODE: Passcode required to sign in to the #inventory console.
# Required in production. In development, defaults to "alder-admin" if omitted.
ADMIN_PASSCODE=""

# Optional Supabase configuration.
# When both are set, the frontend uses Supabase directly instead of the Express JSON store.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
